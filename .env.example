# Copy to .env for host-based (non-Docker) development. docker compose sets these
# itself, so you only need this file if you run `python manage.py runserver` directly.
DEBUG=1
DJANGO_SECRET_KEY=dev-insecure-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
